{
  "name": "multiprint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"vite\" \"npm:server:dev\"",
    "dev:web": "vite",
    "server:dev": "PORT=3001 node --env-file-if-exists=server/.env --watch-path=server server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=server/.env server/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "admin:password": "node --env-file-if-exists=server/.env server/set-password.js"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
