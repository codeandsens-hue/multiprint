# systemd unit: installed to /etc/systemd/system/multiprint.service by setup-server.sh
[Unit]
Description=Multiprint website and API
After=network.target

[Service]
Type=simple
User=multiprint
WorkingDirectory=/var/www/multiprint
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=TRUST_PROXY=1
Environment=DATA_DIR=/var/lib/multiprint
# ADMIN_PASSWORD (first start only) lives here, readable by root only
EnvironmentFile=-/etc/multiprint.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

# Hardening: the app may only write to its data directory
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/multiprint

[Install]
WantedBy=multi-user.target
