# Copy to server/.env and fill in.
# Initial admin password (8+ characters): used only on the first start to create the login.
ADMIN_PASSWORD=change-me-please
PORT=3001
# Set when running behind a reverse proxy (Nginx, Render, Railway…) so visitor IPs are read correctly
# TRUST_PROXY=1
# Where the database and uploaded images are stored (default: ./data at the project root)
# DATA_DIR=/var/lib/multiprint
